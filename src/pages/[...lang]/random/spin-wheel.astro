---
import ToolLayout from "@/layout/ToolLayout.astro";
import '@/assets/styles/pages/random/spinwheel/spin-wheel.css';
import '@/assets/styles/pages/random/spinwheel/controls.css';
import '@/assets/styles/pages/random/spinwheel/winner.css';
import '@/assets/styles/addons/textArea.css';
import '@/assets/styles/addons/copytext.css';

export async function getStaticPaths() {
  return [
    { params: { lang: undefined } }, 
    { params: { lang: 'pt' } },
    
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'id' } },
    { params: { lang: 'hi' } },
  ];
}

import pt from "@/i18n/pages/random/spinwheel/pt.json";
import en from "@/i18n/pages/random/spinwheel/en.json";
import es from "@/i18n/pages/random/spinwheel/es.json";
import fr from "@/i18n/pages/random/spinwheel/fr.json";
import it from "@/i18n/pages/random/spinwheel/it.json";
import de from "@/i18n/pages/random/spinwheel/de.json";
import ru from "@/i18n/pages/random/spinwheel/ru.json";
import id from "@/i18n/pages/random/spinwheel/id.json";
import hi from "@/i18n/pages/random/spinwheel/hi.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi };

const { lang: paramLang } = Astro.params;
const lang = (paramLang === 'en' || !paramLang) ? 'en' : paramLang; 

const d = locales[lang as keyof typeof locales] || locales.en;

const urlPath = lang === 'en' ? '' : `/${lang}`;
const currentUrl = `https://taptotool.com${urlPath}/random/spin-wheel`;
---

<ToolLayout
  title={d.seo.title}
  description={d.seo.description}
  keywords={d.seo.keywords}
  lang={lang}
  canonical={currentUrl}
>
<script type="application/ld+json" slot="ld-json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${currentUrl}#software`,
      "name": d.schema.app_name,
      "alternateName": "Online Spin Wheel",
      "url": currentUrl,
      "image": "https://taptotool.com/assets/imgs/capa_ferramentas/roleta.webp",
      "applicationCategory": ["UtilityApplication", "GameApplication"],
      "operatingSystem": "Any",
      "inLanguage": lang,
      "browserRequirements": "Requires JavaScript",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": d.ui.price_currency || "USD",
        "availability": "https://schema.org/InStock"
      },
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "description": d.schema.app_description
    },
    {
      "@type": "HowTo",
      "@id": `${currentUrl}#howto`,
      "name": d.schema.howto_name,
      "description": d.schema.howto_description,
      "mainEntityOfPage": { "@id": `${currentUrl}#webpage` },
      "totalTime": "PT1M",
      "step": [
        {
          "@type": "HowToStep",
          "name": d.content.step_1,
          "text": d.content.step_1
        },
        {
          "@type": "HowToStep",
          "name": d.content.step_2,
          "text": d.content.step_2
        },
        {
          "@type": "HowToStep",
          "name": d.content.step_3,
          "text": d.content.step_3
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": d.seo.title,
      "isPartOf": { "@id": "https://taptotool.com/#website" },
      "description": d.seo.description,
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "inLanguage": lang,
      "mainEntity": { "@id": `${currentUrl}#software` }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": d.schema.breadcrumb_home,
          "item": "https://taptotool.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": d.schema.breadcrumb_current,
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://taptotool.com/#website",
      "url": "https://taptotool.com/",
      "name": "Tap to Tool",
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": "https://taptotool.com/#organization",
      "name": "Tap to Tool",
      "url": "https://taptotool.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://taptotool.com/engrenagensPNG.svg",
        "width": "512",
        "height": "512"
      },
      "sameAs": [
        "https://www.youtube.com/@TaptoTool",
        "https://www.youtube.com/@TaptoTool-English"
      ]
    }
  ]
})}>
</script>
  
  <div id="container-roletas-controls">
    <div id="roletas-container"></div>
    <div class="controls">
      <ul id="paginacao">
        
      </ul>
      <div id="area-text" data-i18n={JSON.stringify(d.dynamic)}>
        <textarea id="textTip" placeholder={d.ui.placeholder_input}></textarea>
          <div id="container-paste-text">
            <i class="fa-regular fa-clipboard"></i>
            <p>{d.ui.paste_text}</p>
            <p id="ctrlv">{d.ui.paste_shortcut}</p>
          </div>
          <div id="container-bloco-error">
            <p>{d.ui.error_clipboard}</p>
          </div>
          <div class="container-icones-text" id="container-icones-textID">
            <button id="btn-copiar-areatext" title={d.ui.tooltip_copy}>
              <i class="fa-solid fa-copy"></i>
            </button>
            <button id="btn-exlcuir-areatext" title={d.ui.tooltip_delete}>
              <i class="fa-solid fa-trash"></i>
            </button>
          </div>
      </div>
      <button id="addRoulette" class="btn-add">
        <i class="fa-solid fa-plus"></i> {d.ui.add_wheel}
      </button>
    </div>
  </div>

  <div id="background-winner">
    <div id="container-winner">
      <div id="banner-winner">{d.ui.winner_label}</div>
      <div class="container-text-winner">
        <p id="text-winner"></p>
      </div>
      <div class="container-buttons">
        <button id="fechar-winner">{d.ui.btn_close}</button>
        <button id="remove-winner">{d.ui.btn_remove}</button>
      </div>
    </div>
  </div>
  
  <div id="container-roletas"></div>
  <div id="confetti-wrapper"></div>

  <article id="description-area" slot="SEO">
      <header>
          <h1>{d.content.h1_seo}</h1>
          <p>{d.content.intro_text}</p>
      </header>
      <section>
          <h2>{d.content.usage_title}</h2>
          <ol>
              <li>{d.content.step_1}</li>
              <li>{d.content.step_2}
                  <ul>
                      <li><span class="title-list">{d.content.type_input_title}</span>: {d.content.type_input_text}</li>
                      <li><span class="title-list">{d.content.type_edit_title}</span>: {d.content.type_edit_text}</li>
                      <li><span class="title-list">{d.content.type_instant_title}</span>: {d.content.type_instant_text}</li>
                      <li><span class="title-list">{d.content.type_clean_title}</span>: {d.content.type_clean_text}</li>
                  </ul>
              </li>
              <li>{d.content.step_3}</li>
          </ol>
      </section>
      <section>
          <h2>{d.content.benefits_title}</h2>
          <p>{d.content.benefits_intro}</p>
          <ul>
              <li><span class="title-list">{d.content.benefit_1_title}</span><p>- {d.content.benefit_1_text}</p></li>
              <li><span class="title-list">{d.content.benefit_2_title}</span><p>- {d.content.benefit_2_text}</p></li>
              <li><span class="title-list">{d.content.benefit_3_title}</span><p>- {d.content.benefit_3_text}</p></li>
              <li><span class="title-list">{d.content.benefit_4_title}</span><p>- {d.content.benefit_4_text}</p></li>
          </ul>
      </section>
      <footer>
          <p>{d.content.footer_text}</p>
      </footer>
  </article>

  <script>
    import '@/assets/scripts/imports/spinwheel.js';
  </script>
</ToolLayout>