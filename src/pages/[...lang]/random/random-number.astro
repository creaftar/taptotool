---
import ToolLayout from "@/layout/ToolLayout.astro";
import '@/assets/styles/pages/random/random-number.css';
import '@/assets/styles/addons/checkbox.css';

export async function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // /random/randomnumber (default)
    { params: { lang: 'pt' } },
    
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'id' } },
    { params: { lang: 'hi' } },
    { params: { lang: 'zh' } },
  ];
}

import pt from "@/i18n/pages/random/randomnumber/pt.json";
import en from "@/i18n/pages/random/randomnumber/en.json";
import es from "@/i18n/pages/random/randomnumber/es.json";
import fr from "@/i18n/pages/random/randomnumber/fr.json";
import it from "@/i18n/pages/random/randomnumber/it.json";
import de from "@/i18n/pages/random/randomnumber/de.json";
import ru from "@/i18n/pages/random/randomnumber/ru.json";
import id from "@/i18n/pages/random/randomnumber/id.json";
import hi from "@/i18n/pages/random/randomnumber/hi.json";
import zh from "@/i18n/pages/random/randomnumber/zh.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi, zh };

const { lang: paramLang } = Astro.params;
const lang = paramLang || Astro.currentLocale || 'en'; 

const d = locales[lang as keyof typeof locales] || locales.en;

const urlPath = lang === 'en' ? '' : `/${lang}`;
const currentUrl = `https://taptotool.com${urlPath}/random/random-number/`;
---

<ToolLayout
  title={d.seo.title}
  description={d.seo.description}
  keywords={d.seo.keywords}
  lang={lang}
  canonical={currentUrl}
>
<script type="application/ld+json" slot="ld-json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${currentUrl}#software`,
      "name": d.schema.app_name,
      "alternateName": "Random Number Generator",
      "url": currentUrl,
      "image": "https://taptotool.com/assets/imgs/capa_ferramentas/gerador_numeros.webp",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "inLanguage": lang,
      "browserRequirements": "Requires JavaScript",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": d.ui.price_currency || "USD",
        "availability": "https://schema.org/InStock"
      },
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "description": d.schema.app_description
    },
    {
      "@type": "HowTo",
      "@id": `${currentUrl}#howto`,
      "name": d.schema.howto_name,
      "description": d.schema.howto_description,
      "mainEntityOfPage": { "@id": `${currentUrl}#webpage` },
      "totalTime": "PT1M",
      "step": [
        {
          "@type": "HowToStep",
          "name": d.ui.label_min + " & " + d.ui.label_max,
          "text": d.content.usage_instruction
        },
        {
          "@type": "HowToStep",
          "name": d.ui.button_generate,
          "text": d.content.list_item_integers
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": d.seo.title,
      "isPartOf": { "@id": "https://taptotool.com/#website" },
      "description": d.seo.description,
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "inLanguage": lang,
      "mainEntity": { "@id": `${currentUrl}#software` }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": d.schema.breadcrumb_home,
          "item": "https://taptotool.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": d.schema.breadcrumb_current,
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://taptotool.com/#website",
      "url": "https://taptotool.com/",
      "name": "Tap to Tool",
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": "https://taptotool.com/#organization",
      "name": "Tap to Tool",
      "url": "https://taptotool.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://taptotool.com/web-app-manifest-512x512.png",
        "width": "512",
        "height": "512"
      },
      "sameAs": [
        "https://www.youtube.com/@TaptoTool",
        "https://www.youtube.com/@TaptoTool-English"
      ]
    }
  ]
})}>
</script>

  <div id="h1-random">{d.ui.h1_main}</div>
  
  <div id="container-inputs">
    <div class="container-input-label">
      <label for="min-value" class="labels">{d.ui.label_min}</label>
      <input type="number" class="inputs" id="min-value" placeholder={d.ui.placeholder_min}>
    </div>
    <div class="container-input-label">
      <label for="max-value" class="labels">{d.ui.label_max}</label>
      <input type="number" class="inputs" id="max-value" placeholder={d.ui.placeholder_max}>
    </div>
  </div>

  <div class="container-checkbox">
      <input class="checkbox" id="checkboxInteiro" type="checkbox" checked>
      <label for="checkboxInteiro" class="labels">{d.ui.label_checkbox}</label>
  </div>

  <button id="gerar-numero">{d.ui.button_generate}</button>

  <div id="container-resposta">
    <input type="text" disabled class="inputs" id="generated-value" placeholder="0">
  </div>

  <article id="description-area" slot="SEO">
    <header>
      <h1>{d.content.h1_seo}</h1>
      <p>{d.content.intro_text}</p>
    </header>

    <section>
      <h2>{d.content.usage_title}</h2>
      <p>{d.content.usage_instruction}</p>
      <ul>
        <li>{d.content.list_item_integers}</li>
        <li>{d.content.list_item_decimals}</li>
      </ul>
      <p>{d.content.usage_checkbox_info}</p>
    </section>

    <section>
      <h2>{d.content.why_use_title}</h2>
      <p>{d.content.why_use_text}</p>
    </section>

    <footer>
        <p>{d.content.footer_text}</p>
    </footer>
  </article>

  <script>
    import '@/assets/scripts/imports/randomnumber.js';
  </script>
</ToolLayout>