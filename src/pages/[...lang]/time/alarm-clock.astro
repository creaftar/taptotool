---
import ToolLayout from "@/layout/ToolLayout.astro";
import '@/assets/styles/addons/copytext.css';
import '@/assets/styles/global/scrollbar.css';
import '@/assets/styles/pages/time/alarm-clock.css';

export async function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // /time/alarmclock (default)
    
    { params: { lang: 'pt' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'id' } },
    { params: { lang: 'hi' } },
  ];
}

import pt from "@/i18n/pages/time/alarmclock/pt.json";
import en from "@/i18n/pages/time/alarmclock/en.json";
import es from "@/i18n/pages/time/alarmclock/es.json";
import fr from "@/i18n/pages/time/alarmclock/fr.json";
import it from "@/i18n/pages/time/alarmclock/it.json";
import de from "@/i18n/pages/time/alarmclock/de.json";
import ru from "@/i18n/pages/time/alarmclock/ru.json";
import id from "@/i18n/pages/time/alarmclock/id.json";
import hi from "@/i18n/pages/time/alarmclock/hi.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi };

const { lang: paramLang } = Astro.params;
const lang = paramLang || Astro.currentLocale || 'en'; 

const d = locales[lang as keyof typeof locales] || locales.en;

const urlPath = lang === 'en' ? '' : `/${lang}`;
const currentUrl = `https://taptotool.com${urlPath}/time/alarm-clock`;
---

<ToolLayout
  title={d.seo.title}
  description={d.seo.description}
  keywords={d.seo.keywords}
  lang={lang}
  canonical={currentUrl}
>
<script type="application/ld+json" slot="ld-json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${currentUrl}#software`,
      "name": d.schema.app_name,
      "alternateName": "Alarm Clock Online",
      "url": currentUrl,
      "image": "https://taptotool.com/assets/imgs/capa_ferramentas/despertador.webp",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "inLanguage": lang,
      "browserRequirements": "Requires JavaScript",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": d.ui.price_currency || "USD",
        "availability": "https://schema.org/InStock"
      },
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "description": d.schema.app_description
    },
    {
      "@type": "HowTo",
      "@id": `${currentUrl}#howto`,
      "name": d.schema.howto_name,
      "description": d.schema.howto_description,
      "mainEntityOfPage": { "@id": `${currentUrl}#webpage` },
      "totalTime": "PT1M",
      "step": [
        {
          "@type": "HowToStep",
          "name": d.content.usage_step1,
          "text": d.content.usage_step1
        },
        {
          "@type": "HowToStep",
          "name": d.content.usage_step2,
          "text": d.content.usage_step2
        },
        {
          "@type": "HowToStep",
          "name": d.content.usage_step3,
          "text": d.content.usage_step3
        },
        {
          "@type": "HowToStep",
          "name": d.content.usage_step4,
          "text": d.content.usage_step4
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": d.seo.title,
      "isPartOf": { "@id": "https://taptotool.com/#website" },
      "description": d.seo.description,
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "inLanguage": lang,
      "mainEntity": { "@id": `${currentUrl}#software` }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": d.schema.breadcrumb_home,
          "item": "https://taptotool.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": d.schema.breadcrumb_current,
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://taptotool.com/#website",
      "url": "https://taptotool.com/",
      "name": "Tap to Tool",
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": "https://taptotool.com/#organization",
      "name": "Tap to Tool",
      "url": "https://taptotool.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://taptotool.com/engrenagensPNG.svg",
        "width": "512",
        "height": "512"
      },
      "sameAs": [
        "https://www.youtube.com/@TaptoTool",
        "https://www.youtube.com/@TaptoTool-English"
      ]
    }
  ]
})}>
</script>

  <div id="container-horario">
    <span id="horario" data-lang={lang}>00:00:00</span>
    <span id="data"></span>
  </div>

  <div id="container-geracao-alarmes" data-i18n={JSON.stringify(d.dynamic)}>
    <div id="container-alarmes"></div>
    <div class="square-alarme-newAlarm" id="addAlarm-container">
      <div class="container-horario-despertar" id="addAlarm">
        {d.ui.add_alarm} <i class="fa-solid fa-alarm-clock"></i>
      </div>
    </div>
  </div>

  <article id="description-area" slot="SEO">
    <header>
      <h1>{d.ui.h1}</h1>
      <p>{d.ui.intro_text}</p>
    </header>

    <section>
      <h2>{d.content.features_title}</h2>
      <ul>
        <li><strong>{d.content.feature_audio.split(':')[0]}:</strong>{d.content.feature_audio.split(':')[1]}</li>
        <li><strong>{d.content.feature_org.split(':')[0]}:</strong>{d.content.feature_org.split(':')[1]}</li>
        <li><strong>{d.content.feature_multiple.split(':')[0]}:</strong>{d.content.feature_multiple.split(':')[1]}</li>
        <li><strong>{d.content.feature_save.split(':')[0]}:</strong>{d.content.feature_save.split(':')[1]}</li>
      </ul>
    </section>

    <section>
      <h2>{d.content.usage_title}</h2>
      <p>1. {d.content.usage_step1}</p>
      <p>2. {d.content.usage_step2}</p>
      <p>3. {d.content.usage_step3}</p>
      <p>4. {d.content.usage_step4}</p>
    </section>

    <section>
      <h2>{d.content.tips_title}</h2>
      <p><i class="fa-solid fa-hand"></i> - {d.content.tip_drag}</p>
      <p><i class="fa-solid fa-pen-to-square"></i> - {d.content.tip_rename}</p>
      <p><i class="fa-solid fa-play"></i> - {d.content.tip_test}</p>
    </section>

    <footer>
      <div class="share-buttons">
        <p>{d.content.footer_text}</p>
      </div>
    </footer>
  </article>

  <script>
    import '@/assets/scripts/imports/alarmclock.js';
  </script>
</ToolLayout>