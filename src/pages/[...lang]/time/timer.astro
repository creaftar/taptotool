---
import ToolLayout from "@/layout/ToolLayout.astro";
import '@/assets/styles/addons/copytext.css';
import '@/assets/styles/global/scrollbar.css';
import '@/assets/styles/pages/time/timer.css';

export async function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'pt' } },
    
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'id' } },
    { params: { lang: 'hi' } },
    { params: { lang: 'zh' } },
  ];
}

import pt from "@/i18n/pages/time/timer/pt.json";
import en from "@/i18n/pages/time/timer/en.json";
import es from "@/i18n/pages/time/timer/es.json";
import fr from "@/i18n/pages/time/timer/fr.json";
import it from "@/i18n/pages/time/timer/it.json";
import de from "@/i18n/pages/time/timer/de.json";
import ru from "@/i18n/pages/time/timer/ru.json";
import id from "@/i18n/pages/time/timer/id.json";
import hi from "@/i18n/pages/time/timer/hi.json";
import zh from "@/i18n/pages/time/timer/zh.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi, zh };

const { lang: paramLang } = Astro.params;
const lang = paramLang || Astro.currentLocale || 'en'; 

const d = locales[lang as keyof typeof locales] || locales.en;

const urlPath = lang === 'en' ? '' : `/${lang}`;
const currentUrl = `https://taptotool.com${urlPath}/time/timer/`;
---

<ToolLayout
  title={d.seo.title}
  description={d.seo.description}
  keywords={d.seo.keywords}
  lang={lang}
  canonical={currentUrl}
>
<script type="application/ld+json" slot="ld-json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${currentUrl}#software`,
      "name": d.schema.app_name,
      "alternateName": "Timer Online",
      "url": currentUrl,
      "image": "https://taptotool.com/assets/imgs/capa_ferramentas/timer.webp",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "inLanguage": lang,
      "browserRequirements": "Requires JavaScript",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": d.ui.unit_currency || "USD",
        "availability": "https://schema.org/InStock"
      },
      "publisher": { "@id": "https://taptotool.com/#organization" }, 
      "description": d.schema.app_description
    },
    {
      "@type": "HowTo",
      "@id": `${currentUrl}#howto`,
      "name": d.schema.howto_name,
      "description": d.schema.howto_description,
      "mainEntityOfPage": { "@id": `${currentUrl}#webpage` },
      "totalTime": "PT1M",
      "step": [
        {
          "@type": "HowToStep",
          "name": d.content.usage_step_1, 
          "text": d.content.usage_step_1
        },
        {
          "@type": "HowToStep",
          "name": d.content.usage_step_2, 
          "text": d.content.usage_step_2
        },
        {
          "@type": "HowToStep",
          "name": d.content.usage_step_3, 
          "text": d.content.usage_step_3
        },
        {
          "@type": "HowToStep",
          "name": d.content.usage_step_4, 
          "text": d.content.usage_step_4
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": d.seo.title,
      "isPartOf": { "@id": "https://taptotool.com/#website" },
      "description": d.seo.description,
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "inLanguage": lang,
      "mainEntity": { "@id": `${currentUrl}#software` }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": d.schema.breadcrumb_home,
          "item": "https://taptotool.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": d.schema.breadcrumb_current,
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://taptotool.com/#website",
      "url": "https://taptotool.com/",
      "name": "Tap to Tool",
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": "https://taptotool.com/#organization",
      "name": "Tap to Tool",
      "url": "https://taptotool.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://taptotool.com/web-app-manifest-512x512.png",
        "width": "512",
        "height": "512"
      },
      "sameAs": [
        "https://www.youtube.com/@TaptoTool",
        "https://www.youtube.com/@TaptoTool-English"
      ]
    }
  ]
})}>
</script>

  <div id="container-horario">
    <span id="horario" data-lang={lang}>00:00:00</span>
    <span id="data"></span>
  </div>
  
  <div id="container-geracao-temporizadores" data-i18n={JSON.stringify(d.dynamic)}>
    <div id="container-temporizadores"></div>
    <div class="square-temporizador-newTimer" id="addTimer-container">
      <div class="container-horario-despertar" id="addTimer">
        {d.ui.new_timer_button} <i class="fa-solid fa-hourglass-start"></i>
      </div>
    </div>
  </div>
  
  <article id="description-area" slot="SEO">
    <header>
      <h1>{d.ui.h1}</h1>
      <p>{d.ui.intro_text}</p>
    </header>

    <section>
      <h2>{d.content.features_title}</h2>
      <ul>
        <li><strong>{d.content.feature_1_title}:</strong> {d.content.feature_1_text}</li>
        <li><strong>{d.content.feature_2_title}:</strong> {d.content.feature_2_text}</li>
        <li><strong>{d.content.feature_3_title}:</strong> {d.content.feature_3_text}</li>
        <li><strong>{d.content.feature_4_title}:</strong> {d.content.feature_4_text}</li>
      </ul>
    </section>

    <section>
      <h2>{d.content.usage_title}</h2>
      <p>{d.content.usage_step_1}</p>
      <p>{d.content.usage_step_2}</p>
      <p>{d.content.usage_step_3}</p>
      <p>{d.content.usage_step_4}</p>
    </section>

    <footer>
        <div class="share-buttons">
            <p>{d.content.footer_share_text}</p>
        </div>
    </footer>
  </article>

  <script>
    import '@/assets/scripts/imports/timer.js';
  </script>
</ToolLayout>