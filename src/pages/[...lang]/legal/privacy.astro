---
import LegalLayout from "@/layout/LegalLayout.astro";
import '@/assets/styles/pages/about/about.css'; // Mantendo seu CSS de páginas legais

export async function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    
    { params: { lang: 'pt' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'id' } },
    { params: { lang: 'hi' } },
  ];
}

import pt from "@/i18n/pages/legal/privacy/pt.json";
import en from "@/i18n/pages/legal/privacy/en.json";
import es from "@/i18n/pages/legal/privacy/es.json";
import fr from "@/i18n/pages/legal/privacy/fr.json";
import it from "@/i18n/pages/legal/privacy/it.json";
import de from "@/i18n/pages/legal/privacy/de.json";
import ru from "@/i18n/pages/legal/privacy/ru.json";
import id from "@/i18n/pages/legal/privacy/id.json";
import hi from "@/i18n/pages/legal/privacy/hi.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi };

const { lang: paramLang } = Astro.params;
const lang = (paramLang === 'en' || !paramLang) ? 'en' : paramLang; 

const d = locales[lang as keyof typeof locales] || locales.en;

const urlPath = lang === 'en' ? '' : `/${lang}`;
const currentUrl = `https://taptotool.com${urlPath}/legal/privacy`;
---

<LegalLayout
  title={d.seo.title}
  description={d.seo.description}
  keywords={d.seo.keywords}
  lang={lang}
  canonical={currentUrl}
>

<script type="application/ld+json" slot="ld-json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": d.seo.title,
      "description": d.seo.description,
      "isPartOf": { "@id": "https://taptotool.com/#website" },
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "inLanguage": lang,
      "mainEntity": {
        "@type": "PrivacyPolicy",
        "@id": `${currentUrl}#privacy`,
        "name": d.schema.page_name,
        "description": d.schema.page_description,
        "url": currentUrl,
        "publisher": { "@id": "https://taptotool.com/#organization" }
      }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": d.schema.breadcrumb_home,
          "item": "https://taptotool.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": d.schema.breadcrumb_current,
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://taptotool.com/#website",
      "url": "https://taptotool.com/",
      "name": "Tap to Tool",
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": "https://taptotool.com/#organization",
      "name": "Tap to Tool",
      "url": "https://taptotool.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://taptotool.com/web-app-manifest-512x512.png",
        "width": "512",
        "height": "512"
      },
      "sameAs": [
        "https://www.youtube.com/@TaptoTool",
        "https://www.youtube.com/@TaptoTool-English"
      ]
    }
  ]
})}>
</script>

  <article class="legal-content">
    <h1>{d.content.title}</h1>
    
    <p set:html={d.content.intro}></p>

    {d.content.sections.map((section) => (
      <section>
        <h2>{section.title}</h2>
        <p>{section.text}</p>
        {section.list && (
          <ul>
            {section.list.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        )}
      </section>
    ))}

    <hr />

    <p class="effective-date">
      <em>{d.content.last_updated}</em>
    </p>
  </article>
</LegalLayout>