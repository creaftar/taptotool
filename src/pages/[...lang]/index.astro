---
//import { Image } from 'astro:assets';
import BaseLayout from '@/layout/BaseLayout.astro';
import Banner from '@/components/index/Banner.astro';
import Email from '@/components/index/Email.astro';
//import Kit from '@/components/index/kit.astro';
import Pages from '@/components/index/pages.astro';
import Footer from '@/components/gadgets/footer.astro';
import '@/assets/styles/pages/index/index.css';
//import '@/assets/styles/taptotool/css/ttt.css';


export async function getStaticPaths() {
  return [
    { params: { lang: undefined } },
    { params: { lang: 'pt' } },
    
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'id' } },
    { params: { lang: 'hi' } },
  ];
}

const lang = Astro.currentLocale || 'en'; 

import pt from "@/i18n/pages/index/pt.json";
import en from "@/i18n/pages/index/en.json";
import es from "@/i18n/pages/index/es.json";
import fr from "@/i18n/pages/index/fr.json";
import it from "@/i18n/pages/index/it.json";
import de from "@/i18n/pages/index/de.json";
import ru from "@/i18n/pages/index/ru.json";
import id from "@/i18n/pages/index/id.json";
import hi from "@/i18n/pages/index/hi.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi };
const d = locales[lang as keyof typeof locales] || locales.en;
const currentUrl = `https://taptotool.com/${lang}`;
---

<BaseLayout
  title={d.seo.title}
  description={d.seo.description}
  keywords={d.seo.keywords}
  lang={lang}
  canonical={currentUrl}
>
<script type="application/ld+json" is:inline set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "Organization",
      "@id": "https://taptotool.com/#organization",
      "name": "Tap to Tool",
      "url": "https://taptotool.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://taptotool.com/web-app-manifest-512x512.png",
        "width": "512",
        "height": "512"
      },
      "sameAs": [
        "https://www.youtube.com/@TaptoTool",
        "https://www.youtube.com/@TaptoTool-English"
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://taptotool.com/#website",
      "url": "https://taptotool.com/",
      "name": "Tap to Tool",
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "inLanguage": lang
    },
    {
      "@type": ["WebPage", "CollectionPage"],
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": d.seo.title,
      "isPartOf": { "@id": "https://taptotool.com/#website" },
      "description": d.seo.description,
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "inLanguage": lang,
      "about": [
        { "@id": "https://taptotool.com/#organization" },
        {
          "@type": "Thing",
          "name": "Software as a Service",
          "sameAs": "https://www.wikidata.org/wiki/Q170520"
        },
        {
          "@type": "Thing",
          "name": "Web Tool",
          "sameAs": "https://www.wikidata.org/wiki/Q107127532"
        }
      ]
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": "Home",
          "item": "https://taptotool.com/"
        }
      ]
    }
  ]
})}>
</script>
<!--<link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/@taptotool/icons@0.0.5/css/ttt.css">-->

<div id="container-conteudo">
    <Banner lang={lang} />
    
    <!--
    <hr class="hr-content">
    
    <div class="ferramentas-por-topicos">
      <Kit lang={lang} />
    </div>-->
  </div>
  <div id="container-all-icons">
    <Pages lang={lang} />
  </div>
  <div class="ferramentas-por-topicos">  
    <Email lang={lang} />
  </div>
  <Footer lang={lang} />
  <script>
    import '@/assets/scripts/imports/index.js'
  </script>
</BaseLayout>