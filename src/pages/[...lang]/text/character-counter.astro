---
import ToolLayout from "@/layout/ToolLayout.astro";
import '@/assets/styles/pages/text/character-counter.css';
import '@/assets/styles/addons/copytext.css';
import '@/assets/styles/global/scrollbar.css';

export async function getStaticPaths() {
  return [
    { params: { lang: undefined } }, // /character-counter (default)
          // /en/character-counter
    { params: { lang: 'pt' } },
    { params: { lang: 'es' } },
    { params: { lang: 'fr' } },
    { params: { lang: 'it' } },
    { params: { lang: 'de' } },
    { params: { lang: 'ru' } },
    { params: { lang: 'id' } },
    { params: { lang: 'hi' } },
  ];
}

import pt from "@/i18n/pages/text/charactercounter/pt.json";
import en from "@/i18n/pages/text/charactercounter/en.json";
import es from "@/i18n/pages/text/charactercounter/es.json";
import fr from "@/i18n/pages/text/charactercounter/fr.json";
import it from "@/i18n/pages/text/charactercounter/it.json";
import de from "@/i18n/pages/text/charactercounter/de.json";
import ru from "@/i18n/pages/text/charactercounter/ru.json";
import id from "@/i18n/pages/text/charactercounter/id.json";
import hi from "@/i18n/pages/text/charactercounter/hi.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi };

const { lang: paramLang } = Astro.params;
const lang = (paramLang === 'en' || !paramLang) ? 'en' : paramLang; 

const d = locales[lang as keyof typeof locales] || locales.en;

const urlPath = lang === 'en' ? '' : `/${lang}`;
const currentUrl = `https://taptotool.com${urlPath}/character-counter/`;
---

<ToolLayout
  title={d.seo.title}
  description={d.seo.description}
  keywords={d.seo.keywords}
  lang={lang}
  canonical={currentUrl}
>
<script type="application/ld+json" slot="ld-json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebApplication",
      "@id": `${currentUrl}#software`,
      "name": d.schema.app_name,
      "alternateName": "Online Character Counter",
      "url": currentUrl,
      "image": "https://taptotool.com/assets/imgs/capa_ferramentas/gerador_caracteres.webp",
      "applicationCategory": "UtilityApplication",
      "operatingSystem": "Any",
      "inLanguage": lang,
      "browserRequirements": "Requires JavaScript",
      "offers": {
        "@type": "Offer",
        "price": "0",
        "priceCurrency": d.ui.price_currency || "USD",
        "availability": "https://schema.org/InStock"
      },
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "description": d.schema.app_description
    },
    {
      "@type": "HowTo",
      "@id": `${currentUrl}#howto`,
      "name": d.schema.howto_name,
      "description": d.schema.howto_description,
      "mainEntityOfPage": { "@id": `${currentUrl}#webpage` },
      "totalTime": "PT1M",
      "step": [
        {
          "@type": "HowToStep",
          "name": d.content.step_1,
          "text": d.content.step_1
        },
        {
          "@type": "HowToStep",
          "name": d.content.step_2,
          "text": d.content.step_2
        }
      ]
    },
    {
      "@type": "WebPage",
      "@id": `${currentUrl}#webpage`,
      "url": currentUrl,
      "name": d.seo.title,
      "isPartOf": { "@id": "https://taptotool.com/#website" },
      "description": d.seo.description,
      "breadcrumb": { "@id": `${currentUrl}#breadcrumb` },
      "inLanguage": lang,
      "mainEntity": { "@id": `${currentUrl}#software` }
    },
    {
      "@type": "BreadcrumbList",
      "@id": `${currentUrl}#breadcrumb`,
      "itemListElement": [
        {
          "@type": "ListItem",
          "position": 1,
          "name": d.schema.breadcrumb_home,
          "item": "https://taptotool.com/"
        },
        {
          "@type": "ListItem",
          "position": 2,
          "name": d.schema.breadcrumb_current,
          "item": currentUrl
        }
      ]
    },
    {
      "@type": "WebSite",
      "@id": "https://taptotool.com/#website",
      "url": "https://taptotool.com/",
      "name": "Tap to Tool",
      "publisher": { "@id": "https://taptotool.com/#organization" },
      "inLanguage": lang
    },
    {
      "@type": "Organization",
      "@id": "https://taptotool.com/#organization",
      "name": "Tap to Tool",
      "url": "https://taptotool.com/",
      "logo": {
        "@type": "ImageObject",
        "url": "https://taptotool.com/web-app-manifest-512x512.png",
        "width": "512",
        "height": "512"
      },
      "sameAs": [
        "https://www.youtube.com/@TaptoTool",
        "https://www.youtube.com/@TaptoTool-English"
      ]
    }
  ]
})}>
</script>

  <div id="area-text" data-i18n={JSON.stringify(d.dynamic)}>
      <textarea id="textTip" data-i18n={JSON.stringify(d.dynamic)}></textarea>
      
      <div id="container-paste-text">
        <i class="fa-regular fa-clipboard"></i>
        <p>{d.ui.paste_text}</p>
        <p id="ctrlv">{d.ui.paste_shortcut}</p>
      </div>
      
      <div id="container-bloco-error">
        <p>{d.ui.error_clipboard}</p>
      </div>
      
      <div class="container-icones-text" id="container-icones-textID">
        <button id="btn-copiar-areatext" title={d.ui.tooltip_copy}>
          <i class="fa-solid fa-copy"></i>
        </button>
        <button id="btn-exlcuir-areatext" title={d.ui.tooltip_delete}>
          <i class="fa-solid fa-trash"></i>
        </button>
      </div>
  </div>

  <div id="result-text">
      <div class="bloco-info">
        <span id="caracteres-sem-espaco" class="resposta">0</span>
        <p class="descricao">{d.ui.res_chars_no_spaces}</p>
      </div>
      <div class="bloco-info">
        <span id="caracteres" class="resposta">0</span>
        <p class="descricao">{d.ui.res_chars}</p>
      </div>
      <div class="bloco-info">
        <span id="palavras" class="resposta">0</span>
        <p class="descricao">{d.ui.res_words}</p>
      </div>
      <div class="bloco-info">
        <span id="frases" class="resposta">0</span>
        <p class="descricao">{d.ui.res_sentences}</p>
      </div>
      <div class="bloco-info">
        <span id="linhas" class="resposta">0</span>
        <p class="descricao">{d.ui.res_lines}</p>
      </div>
      <div class="bloco-info ultimo-bloco-info">
        <span id="paragrafos" class="resposta">0</span>
        <p class="descricao">{d.ui.res_paragraphs}</p>
      </div>

      <div class="container-icones-result container-icones-result-body">
        <button id="btn-copiar-result" title={d.ui.tooltip_copy_results}>
          <i class="fa-regular fa-copy"></i>
        </button>
      </div>
  </div>

  <article id="description-area" slot="SEO">
      <header>
          <h1>{d.content.h1_seo}</h1>
          <p>{d.content.intro_text}</p>
      </header>
      <section>
          <h2>{d.content.usage_title}</h2>
          <ol>
              <li>{d.content.step_1}</li>
              <li>{d.content.step_2}</li>
          </ol>
      </section>
      <section>
          <h2>{d.content.why_use_title}</h2>
          <p>{d.content.why_use_text}</p>
      </section>
      <footer>
          <div class="share-buttons">
              <p>{d.content.footer_text}</p>
          </div>
      </footer>
  </article>

  <script>
    import '@/assets/scripts/imports/charactercounter.js';
  </script>

</ToolLayout>