---
import Nav from '@/components/nav.astro';
import '@/assets/styles/global/esqueleto.css';
import '@/assets/styles/global/global.css';
import '@/assets/styles/fontawesome/css/all.min.css';

const { 
  title = "Tap to Tool", 
  description = "Encontre o que quiser em uma coleção de ferramentas online, gratuitas e rápidas para o seu dia a dia", 
  keywords = "contador de letras, contador de palavras, contador de frases, contador de paragrafos, contador de linhas, contador de caracteres sem espaço, contador de caracteres, contador de caracteres no word, contador de caracteres online, contador de caracteres de texto, contador de caracteres escritos, contador de palavras e caracteres, contador de caracteres em um texto, contador de palavras e caracteres, contador de caracteres online gratis, contador de caracteres sem espaco",
  lang = "en",
  //canonical = "https://taptotool.com/" 
} = Astro.props;

const supportedLanguages = ['en', 'pt', 'es', 'fr', 'it', 'de', 'ru', 'id', 'hi'];
const baseUrl = "https://taptotool.com";

const pathname = Astro.url.pathname;

const pathSegments = pathname.split('/').filter(Boolean);
const firstSegmentIsLang = supportedLanguages.includes(pathSegments[0]);
const purePath = firstSegmentIsLang ? pathSegments.slice(1).join('/') : pathSegments.join('/');

const langPrefixForCanonical = lang === 'en' ? '' : `/${lang}`;
const dynamicCanonical = `${baseUrl}${langPrefixForCanonical}/${purePath}`.replace(/\/$/, "");
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <meta charset="utf-8">
        <link rel="canonical" href={dynamicCanonical} />

        {supportedLanguages.map((l) => {
          // Se for inglês, não coloca prefixo. Se for outro, coloca /l
          const lPrefix = l === 'en' ? '' : `/${l}`;
          // Monta a URL final: base + prefixo + rota da ferramenta
          const altUrl = `${baseUrl}${lPrefix}/${purePath}`.replace(/\/$/, ""); 
          
          return <link rel="alternate" hreflang={l} href={altUrl} />;
        })}

        <link rel="alternate" hreflang="x-default" href={`${baseUrl}/${purePath}`.replace(/\/$/, "")} />
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{title}</title>
        
