---
import Nav from '@/components/nav.astro';
import '@/assets/styles/global/esqueleto.css';
import '@/assets/styles/global/global.css';
import '@/assets/styles/fontawesome/css/all.min.css';

const { 
  title = "Tap to Tool", 
  description = "Encontre o que quiser em uma coleção de ferramentas online, gratuitas e rápidas para o seu dia a dia", 
  keywords = "contador de letras, contador de palavras, contador de frases, contador de paragrafos, contador de linhas, contador de caracteres sem espaço, contador de caracteres, contador de caracteres no word, contador de caracteres online, contador de caracteres de texto, contador de caracteres escritos, contador de palavras e caracteres, contador de caracteres em um texto, contador de palavras e caracteres, contador de caracteres online gratis, contador de caracteres sem espaco",
  lang = "en",
} = Astro.props;

const supportedLanguages = ['en', 'pt', 'es', 'fr', 'it', 'de', 'ru', 'id', 'hi'];
const baseUrl = "https://taptotool.com";

const pathname = Astro.url.pathname;

// Trata o caminho limpando barras iniciais/finais e identificando o idioma
const pathSegments = pathname.split('/').filter(Boolean);
const firstSegmentIsLang = supportedLanguages.includes(pathSegments[0]);
const purePath = firstSegmentIsLang ? pathSegments.slice(1).join('/') : pathSegments.join('/');

// Função auxiliar para construir URLs padronizadas
const buildUrl = (targetLang: any, path: any) => {
  const isEnglish = targetLang === 'en';
  const isHome = !path;

  // Se for a Home em Inglês, retorna sem barra final
  if (isEnglish && isHome) {
    return baseUrl;
  }

  // Prepara o trecho do idioma (vazio para 'en')
  const langSegment = isEnglish ? '' : `/${targetLang}`;
  
  // Prepara o trecho da rota interna
  const pathSegment = isHome ? '' : `/${path}`;

  // Para qualquer outra combinação, garante a barra no final
  return `${baseUrl}${langSegment}${pathSegment}/`;
};

// URL Canônica dinâmica
const dynamicCanonical = buildUrl(lang, purePath);

// URL do x-default (aponta para a versão padrão sem idioma/inglês)
const xDefaultUrl = buildUrl('en', purePath);
---

<!DOCTYPE html>
<html lang={lang}>
    <head>
        <meta charset="utf-8">
        <link rel="canonical" href={dynamicCanonical} />

        {supportedLanguages.map((l) => {
        const altUrl = buildUrl(l, purePath);
        return <link rel="alternate" hreflang={l} href={altUrl} />;
        })}

        <link rel="alternate" hreflang="x-default" href={xDefaultUrl} />
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>{title}</title>
        
        <link rel="shortcut icon" href="/assets/imgs/logo/t.svg" type="image/svg+xml" media="(prefers-color-scheme: light)" />
        <link rel="shortcut icon" href="/assets/imgs/logo/t_dark.svg" type="image/svg+xml" media="(prefers-color-scheme: dark)" />
        <link rel="icon" href="/favicon.ico" type="image/x-icon" media="(prefers-color-scheme: dark)">
        <link rel="icon" href="/assets/imgs/logo/t.svg" type="image/svg+xml">
        
        <meta name="robots" content="index, follow" />
        <meta name="description" content={description}/>
        <meta name="keywords" content={keywords}/>
        <meta name="author" content="Tap to Tool" />
        <meta name="application-name" content="Tap to Tool" />
        <meta name="theme-color" content="rgb(255, 255, 255)" />
        <meta name="google-adsense-account" content="ca-pub-3201959726673479" />

        <meta property="og:locale" content={lang} />
        <meta property="og:locale:alternate" content="en" />
        
        <meta property="og:image" content="/assets/imgs/logo/t.svg" />
        
        <meta property="og:site" content="Tap to Tool" />
        <meta property="og:site_name" content="Tap to Tool" />
        <meta property="og:type" content="website" />
        <meta property="og:url" content={dynamicCanonical} />
        <meta property="og:title" content={title} />
        <meta property="og:description" content={description} />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:description" content={description} />
        <meta name="twitter:image" content="/assets/imgs/logo/t.svg" />
        <meta name="twitter:title" content={ `${title}` } />
        <meta property="twitter:site" content="@Tap to Tool" />
        <meta property="twitter:title" content={ `${title}` }/>
        <meta property="twitter:creator" content="@taptotool" />
        
        <link rel="manifest" href="/manifest.json" />
        
        <slot name="ld-json" />

        <script is:inline src="/precarregar.js?v=1.0.1"></script>
        <link href="/precarregar.css?v=1.0.2" rel="stylesheet" />
    </head>
    <body>
        
        <div id="carrega_tela">
            <div id="loadingBar"></div>
        </div>
        <slot name="adLeft"><!--Desative seu adblock!--></slot>
        <header id="menuContainer">
            <Nav />
        </header>
        <main id="container-body">
            <slot />
        </main>
        <slot name="adRight"><!--Desative seu adblock!--></slot>

        
        <script>
            import { InicializarMenu } from '@/assets/scripts/menu/menu.js';
            InicializarMenu();
        </script>
        <slot name="scripts" />
    </body>
</html>