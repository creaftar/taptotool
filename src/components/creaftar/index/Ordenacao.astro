    { params: { lang: 'hi' } },
  ];
}*/

const lang = Astro.currentLocale || 'en'; 

import pt from "@/i18n/pages/game/crossword/pages/index/ordenacao/pt.json";
import en from "@/i18n/pages/game/crossword/pages/index/ordenacao/en.json";
import es from "@/i18n/pages/game/crossword/pages/index/ordenacao/es.json";
import fr from "@/i18n/pages/game/crossword/pages/index/ordenacao/fr.json";
import it from "@/i18n/pages/game/crossword/pages/index/ordenacao/it.json";
import de from "@/i18n/pages/game/crossword/pages/index/ordenacao/de.json";
import ru from "@/i18n/pages/game/crossword/pages/index/ordenacao/ru.json";
import id from "@/i18n/pages/game/crossword/pages/index/ordenacao/id.json";
import hi from "@/i18n/pages/game/crossword/pages/index/ordenacao/hi.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi };
const d = locales[lang as keyof typeof locales].sorting || locales.en.sorting;
---

<div class="menu-content-cruzadinhas">
    <div id="container-ordenacao">
        <div class="bloco-ordenacao">
            <p>{d.sort_by}</p>
            <div class="button-ordenacao">
                <span id="menu-ordenacao-text">{d.opt_latest}</span>
                <i class="fa-solid fa-caret-down"></i>
                <ul id="menu-ordenacao-paginas" class="menu-ordenacao menu-ordenacao1 elemento-invisivel">
                    <li data-opcao="latest">{d.opt_latest}</li>
                    <li data-opcao="oldest">{d.opt_oldest}</li>
                    <li data-opcao="a-z">{d.opt_az}</li>
                    <li data-opcao="z-a">{d.opt_za}</li>
                </ul>
            </div>
        </div>

        <div class="bloco-ordenacao">
            <p>{d.display_per_page}</p>
            <div class="button-ordenacao button-ordenacao2">
                <span id="text-limit-pages">20</span>
                <i class="fa-solid fa-caret-down"></i>
                <ul id="menu-limite-paginas" class="menu-ordenacao menu-ordenacao2 elemento-invisivel">
                    <li>60</li>
                    <li>50</li>
                    <li>40</li>
                    <li>30</li>
                    <li>20</li>
                    <li>10</li>
                </ul>
            </div>
        </div>

        <div class="bloco-ordenacao">
            <div class="container-paginas">
                <button id="recuar-pagina" aria-label={d.btn_prev_aria}>
                    <i class="fa-solid fa-angle-left fa-small"></i>
                </button>
                <ul id="lista-dinamica"></ul>
                <button id="avancar-pagina" aria-label={d.btn_next_aria}>
                    <i class="fa-solid fa-angle-right fa-small"></i>
                </button>
                
                <div class="button-ordenacao button-ordenacao3">
                    <span id="text-box-ordenacao"></span>
                    <i class="fa-solid fa-caret-down"></i>
                    <ul class="menu-ordenacao menu-ordenacao3 elemento-invisivel" id="box-ordenacao"></ul>
                </div>

                <div class="timer-paginas">
                    <i class="fa-solid fa-clock"></i><span id="timespan"> 3</span>
                </div>
            </div>
        </div>
    </div>
</div>