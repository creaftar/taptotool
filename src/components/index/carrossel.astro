---
import { Image } from 'astro:assets';

interface Props {
  lang?: string;
}

import imgDespertador from '@/assets/imgs/capa_ferramentas/despertador.webp';
import imgCaracteres from '@/assets/imgs/capa_ferramentas/gerador_caracteres.webp';
import imgCronometro from '@/assets/imgs/capa_ferramentas/cronometro.webp';
import imgNumeros from '@/assets/imgs/capa_ferramentas/gerador_numeros.webp';
import imgOrdemAlfabetica from '@/assets/imgs/capa_ferramentas/ordem_alfabetica.webp';
import imgAnuncioCreaftar from '@/assets/imgs/capa_cartoes/creaftar.webp';

import '@/assets/styles/pages/index/bloco-carrossel/carrossel.css';
import '@/assets/styles/pages/index/bloco-carrossel/banner.css';
import '@/assets/styles/pages/index/bloco-carrossel/father.css';
import '@/assets/styles/pages/index/bloco-carrossel/update.css';

import pt from "@/i18n/pages/index/carrossel/pt.json";
import en from "@/i18n/pages/index/carrossel/en.json";
import es from "@/i18n/pages/index/carrossel/es.json";
import fr from "@/i18n/pages/index/carrossel/fr.json";
import it from "@/i18n/pages/index/carrossel/it.json";
import de from "@/i18n/pages/index/carrossel/de.json";
import ru from "@/i18n/pages/index/carrossel/ru.json";
import id from "@/i18n/pages/index/carrossel/id.json";
import hi from "@/i18n/pages/index/carrossel/hi.json";

const locales = { pt, en, es, fr, it, de, ru, id, hi };

// Detecta o idioma via Props (se passado) ou via URL nativa do Astro
const { lang: propLang } = Astro.props;
const lang = propLang || Astro.currentLocale || 'en'; 

const d = locales[lang as keyof typeof locales] || locales.en;

// Helper para links: se for 'en' (default), o prefixo é vazio. Se for outro, ex: '/es'
const langPrefix = lang === 'en' ? '' : `/${lang}`;
---

<div id="container-carrosel-and-cards">
  <div id="container-container-and-description">
    <p class="description-card">{d.carousel_section.header.main_title}</p>
    <div id="container-carrossel-and-icons">
      <button id="prev-btn" class="nav-btn" aria-label="Prev"><i class="fa-solid fa-angle-left fa-lg"></i></button>
      <button id="next-btn" class="nav-btn" aria-label="Next"><i class="fa-solid fa-angle-right fa-lg"></i></button>
      
      <div class="container-content" id="carrossel-container">
        <div class="card">
          <a href={`${langPrefix}/time/alarm-clock`}>
            <div class="icone-animado icone-tempo">
              <i class="icons-aside fa-solid fa-arrow-right-from-bracket end-topic"></i>
            </div>
            <div class="img-card">
              <Image src={imgDespertador} alt={d.carousel_section.cards.alarm.alt_text} loading="eager"/>
            </div>
            <div class="footer-card footer-tempos">
              <p>{d.carousel_section.cards.alarm.title}</p>
            </div>
          </a>
        </div>

        <div class="card">
          <a href={`${langPrefix}/text/character-counter`}>
            <div class="icone-animado icone-texto">
              <i class="icons-aside fa-solid fa-arrow-right-from-bracket end-topic"></i>
            </div>
            <div class="img-card">
              <Image src={imgCaracteres} alt={d.carousel_section.cards.char_counter.alt_text} loading="eager"/>
            </div>
            <div class="footer-card footer-textos">
              <p>{d.carousel_section.cards.char_counter.title}</p>
            </div>
          </a>
        </div>

        <div class="card">
          <a href={`${langPrefix}/time/stopwatch`}>
            <div class="icone-animado icone-tempo">
              <i class="icons-aside fa-solid fa-arrow-right-from-bracket end-topic"></i>
            </div>
            <div class="img-card">
              <Image src={imgCronometro} alt={d.carousel_section.cards.stopwatch.alt_text} />
            </div>
            <div class="footer-card footer-tempos">
              <p>{d.carousel_section.cards.stopwatch.title}</p>
            </div>
          </a>
        </div>

        <div class="card">
          <a href={`${langPrefix}/math/random-number`}>
            <div class="icone-animado icone-matematica">
              <i class="icons-aside fa-solid fa-arrow-right-from-bracket end-topic"></i>
            </div>
            <div class="img-card">
              <Image src={imgNumeros} alt={d.carousel_section.cards.random_number.alt_text} />
            </div>
            <div class="footer-card footer-matematica">
              <p>{d.carousel_section.cards.random_number.title}</p>
            </div>
          </a>
        </div>

        <div class="card">
          <a href={`${langPrefix}/text/alphabetical-order`}>
            <div class="icone-animado icone-texto">
              <i class="icons-aside fa-solid fa-arrow-right-from-bracket end-topic"></i>
            </div>
            <div class="img-card">
              <Image src={imgOrdemAlfabetica} alt={d.carousel_section.cards.alphabetical_order.alt_text} />
            </div>
            <div class="footer-card footer-textos">
              <p>{d.carousel_section.cards.alphabetical_order.title}</p>
            </div>
          </a>
        </div>
      </div>
    </div>
  </div>

  <div class="novidade">
    <div class="container-msg-icon">
      <p class="description-card">
        {d.newsletter_section.title} <i class="fa-solid fa-circle-question icon-tooltip"></i>
      </p>
      <span class="tooltip-text">
        <i class="fa-solid fa-circle-question"></i> - {d.newsletter_section.tooltip}
      </span>
    </div>
    <div class="container-msg">
      <div class="container-img-banner">
