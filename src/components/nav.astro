---
import { getRelativeLocaleUrl } from 'astro:i18n';

const currentLang = Astro.currentLocale || 'en';

const { pathname } = Astro.url;

/*function getTargetUrl(targetLang: string) {
  // Removemos o prefixo do idioma atual do início do pathname
  // Isso transforma "/de/contato" em "/contato" ou "/de/" em "/"
  const basePage = pathname.replace(`/${currentLang}`, '');
  
  // O getRelativeLocaleUrl vai colocar o novo idioma corretamente
  // Ex: getRelativeLocaleUrl('pt', '/contato') -> /pt/contato
  return getRelativeLocaleUrl(targetLang, basePage || '/');
}*/

function getTargetUrl(targetLang: string) {
  const langPrefixRegex = new RegExp(`^/${currentLang}(/|$)`);
  
  let basePage = pathname.replace(langPrefixRegex, '');

  basePage = basePage.replace(/\/$/, "");

  const url = getRelativeLocaleUrl(targetLang, basePage || '/');

  return url.endsWith('/') && url !== '/' ? url.slice(0, -1) : url;
}
